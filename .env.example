# Copy to .env.local and fill in. Everything here is server-only except the
# NEXT_PUBLIC_* entries, which are inlined into the browser bundle at build
# time — never put a secret behind that prefix.

# --- Supabase: the board lives here -----------------------------------------
# Project settings → Data API → Project URL
SUPABASE_URL=
# Project settings → API keys → service_role. Bypasses row-level security, so
# it is a full-access key: server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe: bids are charged here ------------------------------------------
# Developers → API keys → Secret key. sk_test_… against test mode.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret (whsec_…). Locally,
# `stripe listen` prints its own — they are different secrets.
STRIPE_WEBHOOK_SECRET=

# --- Sanity: blog and page content ------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Clerk: organizer accounts ----------------------------------------------
# Production needs a Clerk *production* instance (pk_live_/sk_live_) with the
# live domain registered. The dev pk_test_/sk_test_ pair only works on
# localhost — pointing it at the live domain is what took the site down.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
